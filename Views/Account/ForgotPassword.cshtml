@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }

<section class="auth-page" aria-labelledby="forgot-password-title">
    <div class="auth-layout">
        <aside class="auth-intro auth-intro--image">
            <img class="auth-emblem" src="~/images/jharkhand-state-emblem.png" alt="Jharkhand State Emblem" width="58" height="58" />
            <span class="auth-eyebrow">Account assistance</span>
            <h2>Recover portal access</h2>
            <p>Request a password reset link using the email address associated with your vendor account.</p>
            <ul class="auth-benefits"><li>Use your registered email</li><li>Check your inbox for the reset link</li><li>Never share your password</li></ul>
        </aside>
        <div class="auth-form-panel">
            <h1 id="forgot-password-title">Forgot password?</h1>
            <p class="auth-subtitle">Enter your registered email address and we will provide the next step if an account is available.</p>
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            </form>
            <div class="auth-links"><a asp-action="Login">← Return to sign in</a></div>
        </div>
    </div>
</section>
