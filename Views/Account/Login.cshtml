@model LoginViewModel
@{ ViewData["Title"] = "Login"; }

<section class="auth-page" aria-labelledby="login-title">
    <div class="auth-layout">
        <aside class="auth-intro auth-intro--image">
            <img class="auth-emblem" src="~/images/jharkhand-state-emblem.png" alt="Jharkhand State Emblem" width="58" height="58" />
            <span class="auth-eyebrow">Vendor services</span>
            <h2>Welcome back to the vendor portal</h2>
            <p>Sign in to access your vendor application, submit documents and review status updates.</p>
            <ul class="auth-benefits">
                <li>Secure account access</li>
                <li>Application tracking</li>
                <li>Document management</li>
            </ul>
        </aside>
        <div class="auth-form-panel">
            <h1 id="login-title">Sign in</h1>
            <p class="auth-subtitle">Use the email address and password registered with this portal.</p>
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign in securely <span aria-hidden="true">→</span></button>
            </form>
            <div class="auth-links">
                <p>New vendor? <a asp-action="Register">Create an account</a></p>
                <a asp-action="ForgotPassword">Forgot password?</a>
            </div>
            <div class="auth-security-note">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                <span>For your security, sign out after using the portal on a shared device.</span>
            </div>
        </div>
    </div>
</section>
