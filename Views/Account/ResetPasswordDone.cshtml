@{ ViewData["Title"] = "Password reset"; }
<section class="result-panel" aria-labelledby="password-reset-done-title">
    <span class="result-icon" aria-hidden="true">✓</span>
    <h1 id="password-reset-done-title">Password updated</h1>
    <p>Your password has been reset successfully. Sign in with your new password to continue.</p>
    <a asp-action="Login" class="btn btn-primary">Sign in</a>
</section>
