@model string?
@{ ViewData["Title"] = "Reset link sent"; }
<section class="result-panel" aria-labelledby="reset-link-sent-title">
    <span class="result-icon" aria-hidden="true">✉</span>
    <h1 id="reset-link-sent-title">Check your email</h1>
    <p>If an account exists for that email address, a password reset link has been sent. Check your inbox and spam folder.</p>
    @if (Model != null)
    {
        <div class="alert alert-warning mt-3"><strong>Development mode:</strong> Email delivery is not configured. Use this reset link for local testing: <a href="@Model">Open password reset</a></div>
    }
    <a asp-action="Login" class="btn btn-primary mt-2">Return to login</a>
</section>
