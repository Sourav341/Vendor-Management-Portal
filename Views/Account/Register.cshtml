@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-page" aria-labelledby="register-title">
    <div class="auth-layout auth-layout--wide">

        <aside class="auth-intro auth-intro--image">
            <img class="auth-emblem"
                 src="~/images/jharkhand-state-emblem.png"
                 alt="Jharkhand State Emblem"
                 width="50"
                 height="50" />

            <span class="auth-eyebrow">Vendor onboarding</span>

            <h2>Register your business</h2>

            <p>
                Create a vendor account to complete your profile,
                upload the required documents and track your application online.
            </p>

            <ul class="auth-benefits">
                <li>Keep your registration details ready</li>
                <li>Use a valid email and mobile number</li>
                <li>Keep PAN and GST details accurate</li>
            </ul>
        </aside>

        <div class="auth-form-panel">
            <h1 id="register-title">Vendor registration</h1>

            <p class="auth-subtitle">
                Complete your business and personal details to register.
            </p>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName"
                           class="form-control"
                           autocomplete="name" />
                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <!-- Trade Name -->
                <div class="mb-3">
                    <label asp-for="TradeName" class="form-label"></label>
                    <input asp-for="TradeName"
                           class="form-control"
                           autocomplete="organization" />
                    <span asp-validation-for="TradeName"
                          class="text-danger"></span>
                </div>

                <!-- District and Gender -->
                <div class="row g-3">
                    <div class="col-md-6 mb-2">
                        <label asp-for="District" class="form-label"></label>

                        <select asp-for="District"
                                asp-items="ViewBag.Districts"
                                class="form-select">
                            <option value="">-- Select District --</option>
                        </select>

                        <span asp-validation-for="District"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label asp-for="Gender" class="form-label"></label>

                        <select asp-for="Gender"
                                asp-items="ViewBag.Genders"
                                class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger"></span>
                    </div>
                </div>

                <!-- Date of Birth -->
                <div class="mb-3">
                    <label asp-for="DOB" class="form-label"></label>

                    <input asp-for="DOB"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DOB"
                          class="text-danger"></span>
                </div>

                <!-- Father / Husband Name -->
                <div class="mb-3">
                    <label asp-for="Father_Husband_Name"
                           class="form-label"></label>

                    <input asp-for="Father_Husband_Name"
                           class="form-control" />

                    <span asp-validation-for="Father_Husband_Name"
                          class="text-danger"></span>
                </div>

                <!-- Trade Address -->
                <div class="mb-3">
                    <label asp-for="Trade_Address"
                           class="form-label"></label>

                    <textarea asp-for="Trade_Address"
                              class="form-control"
                              rows="3"
                              autocomplete="street-address"></textarea>

                    <span asp-validation-for="Trade_Address"
                          class="text-danger"></span>
                </div>

                <!-- PAN and Mobile -->
                <div class="row g-3">
                    <div class="col-md-6 mb-2">
                        <label asp-for="PanNumber"
                               class="form-label"></label>

                        <input asp-for="PanNumber"
                               class="form-control text-uppercase"
                               maxlength="10"
                               autocomplete="off" />

                        <span asp-validation-for="PanNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label asp-for="MobileNumber"
                               class="form-label"></label>

                        <input asp-for="MobileNumber"
                               class="form-control"
                               maxlength="10"
                               autocomplete="tel"
                               inputmode="numeric" />

                        <span asp-validation-for="MobileNumber"
                              class="text-danger"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <!-- GST -->
                <div class="mb-3">
                    <label asp-for="GstNumber" class="form-label"></label>

                    <input asp-for="GstNumber"
                           class="form-control text-uppercase"
                           maxlength="15"
                           autocomplete="off" />

                    <span asp-validation-for="GstNumber"
                          class="text-danger"></span>
                </div>

                <!-- Passwords -->
                <div class="row g-3">
                    <div class="col-md-6 mb-2">
                        <label asp-for="Password"
                               class="form-label"></label>

                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label asp-for="ConfirmPassword"
                               class="form-label"></label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-text mb-3">
                    Use at least 8 characters, including an uppercase letter,
                    lowercase letter, digit and symbol.
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Create vendor account
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <div class="auth-links">
                <p>
                    Already registered?
                    <a asp-action="Login">Sign in</a>
                </p>
            </div>

            <div class="auth-security-note">
                <span>
                    Check the details carefully before submission.
                    Your registration details will be used for application communication.
                </span>
            </div>
        </div>
    </div>
</section>

