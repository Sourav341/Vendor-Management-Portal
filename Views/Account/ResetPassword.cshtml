@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }

<section class="auth-page" aria-labelledby="reset-password-title">
    <div class="auth-layout">
        <aside class="auth-intro auth-intro--image">
            <img class="auth-emblem" src="~/images/jharkhand-state-emblem.png" alt="Jharkhand State Emblem" width="58" height="58" />
            <span class="auth-eyebrow">Account security</span>
            <h2>Set a new password</h2>
            <p>Choose a strong password that you do not use on other websites.</p>
            <ul class="auth-benefits"><li>Use a unique password</li><li>Include letters, numbers and symbols</li><li>Keep your sign-in details private</li></ul>
        </aside>
        <div class="auth-form-panel">
            <h1 id="reset-password-title">Reset password</h1>
            <p class="auth-subtitle">Enter and confirm your new password below.</p>
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="Code" /><input type="hidden" asp-for="Email" />
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                <button type="submit" class="btn btn-primary w-100">Save new password</button>
            </form>
            <div class="auth-links"><a asp-action="Login">← Return to sign in</a></div>
        </div>
    </div>
</section>
