@model VendorApplication

@{
    ViewData["Title"] = "Dashboard";

    var canEdit = Model.Status is ApplicationStatus.Draft
        or ApplicationStatus.CorrectionsRequired;

    var lastDecision = Model.DecisionHistory
        .OrderByDescending(h => h.DecidedAt)
        .FirstOrDefault();

    var orderedDocuments = Model.Documents
        .OrderBy(x => x.DocumentType.DisplayOrder())
        .ToList();
    var revalidationCycle = ViewBag.CertificateRevalidationCycle as CertificateRevalidationCycle;
}

<!-- Application heading -->
<section class="portal-page-heading"
         id="application-status"
         aria-labelledby="vendor-dashboard-title">
    <div>
        <span class="section-eyebrow">Vendor Workspace</span>
        <h2 id="vendor-dashboard-title">Welcome, @Model.VendorProfile.FullName</h2>
        <p>Manage your application, submit supporting documents and follow review updates.</p>
    </div>

    <div class="status-line">
        Application status
        <span class="badge bg-@Model.Status.Badge()">@Model.Status</span>
    </div>
</section>

<!-- Vendor summary -->
<div class="summary-grid" id="application-summary" aria-label="Vendor details">
    <div class="summary-item">
        <span class="summary-label">PAN</span>
        <span class="summary-value">@Model.VendorProfile.PanNumber</span>
    </div>

    <div class="summary-item">
        <span class="summary-label">GST registration</span>
        <span class="summary-value">
            @(string.IsNullOrWhiteSpace(Model.VendorProfile.GstNumber)
                ? "Not provided"
                : Model.VendorProfile.GstNumber)
        </span>
    </div>

    <div class="summary-item">
        <span class="summary-label">UCAN Number</span>
        <span class="summary-value">
            @(string.IsNullOrWhiteSpace(Model.VendorProfile.UcanNumber)
                ? "Not generated yet"
                : Model.VendorProfile.UcanNumber)
        </span>
    </div>

    <div class="summary-item">
        <span class="summary-label">Next step</span>
        <span class="summary-value">
            @(canEdit ? "Complete documents and submit" : "Check application updates")
        </span>
    </div>
</div>

<!-- Application status and submission messages -->
@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (TempData["ProfileSuccess"] is string profileSuccess)
{
    <div class="alert alert-success" role="status">@profileSuccess</div>
}

@if (TempData["ProfileError"] is string profileError)
{
    <div class="alert alert-danger" role="alert">@profileError</div>
}

@if (Model.Status == ApplicationStatus.CorrectionsRequired && lastDecision?.Remarks != null)
{
    <div class="alert alert-warning" role="alert">
        <strong>Corrections requested by the reviewing officer</strong>
        <div class="mt-1">@lastDecision.Remarks</div>
    </div>
}

@if (Model.Status == ApplicationStatus.Approved)
{
    <div class="alert alert-success" role="status">
        <strong>Application approved.</strong>
        Your application has been approved. Please retain this confirmation for your records.
    </div>
}

@if (Model.Status == ApplicationStatus.Rejected)
{
    <div class="alert alert-danger" role="alert">
        <strong>Application rejected.</strong> @lastDecision?.Remarks
    </div>
}

@if (revalidationCycle is { Status: CertificateRevalidationStatus.Open })
{
    <section class="portal-panel portal-section" aria-labelledby="certificate-revalidation-title">
        <div class="panel-heading">
            <div>
                <h3 id="certificate-revalidation-title">Additional documents requested</h3>
                <p>Your current certificate remains active while these files are reviewed. Upload each requested document so the admin can review it.</p>
            </div>
            <span class="badge text-bg-warning">Review in progress</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Document</th>
                        <th scope="col">Status</th>
                        <th scope="col">Submitted file</th>
                        <th scope="col">Upload / replace</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in revalidationCycle.Documents.OrderBy(d => d.VendorDocument.DocumentType.DisplayOrder()))
                    {
                        var type = request.VendorDocument.DocumentType;
                        var acceptedFileTypes = type == DocumentType.ProfilePhoto
                            ? ".jpg,.jpeg,.png"
                            : ".pdf,.jpg,.jpeg,.png";
                        <tr>
                            <td>
                                <div class="fw-semibold">@type.DisplayName()</div>
                                <div class="small text-muted">Requested by @request.RequestedByAdmin.Email on @request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                @if (!string.IsNullOrWhiteSpace(request.ReviewRemarks))
                                {
                                    <div class="small text-danger mt-1">Admin remarks: @request.ReviewRemarks</div>
                                }
                            </td>
                            <td><span class="badge bg-@request.Status.Badge()">@request.Status</span></td>
                            <td>
                                @if (request.SubmittedVersion is { } version)
                                {
                                    <a asp-controller="Documents" asp-action="Get" asp-route-id="@version.DocumentVersionId" target="_blank" rel="noopener">View v@(version.VersionNumber): @version.OriginalFileName</a>
                                    <div class="small text-muted">Uploaded by @(version.UploadedBy?.Email ?? "You") on @version.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted">Not uploaded</span>
                                }
                            </td>
                            <td>
                                @if (request.Status is DocumentStatus.NotSubmitted or DocumentStatus.Rejected)
                                {
                                    <form asp-action="UploadRevalidationDocument" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-2">
                                        <input type="hidden" name="revalidationDocumentId" value="@request.CertificateRevalidationDocumentId" />
                                        <input type="file" name="file" class="form-control form-control-sm" accept="@acceptedFileTypes" required />
                                        <button type="submit" class="btn btn-sm btn-success align-self-start">
                                            @(request.Status == DocumentStatus.Rejected ? "Replace file" : "Upload file")
                                        </button>
                                        <small class="text-muted">PDF, JPG or PNG · Maximum 3 MB</small>
                                    </form>
                                }
                                else if (request.Status == DocumentStatus.Pending)
                                {
                                    <span class="text-muted small">Waiting for admin review</span>
                                }
                                else
                                {
                                    <span class="text-success small">Approved for this review</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (revalidationCycle is { Status: CertificateRevalidationStatus.Approved })
{
    <div class="alert alert-success" role="status">
        The latest requested documents were approved on @revalidationCycle.ApprovedAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm").
    </div>
}

<!-- Required documents -->
    <section class="portal-panel portal-section"
             id="required-documents"
             aria-labelledby="documents-title">
        <div class="panel-heading">
            <div>
                <h3 id="documents-title">Required documents</h3>
                <p>
                    Select or replace files below. Rejected or missing documents can also be uploaded
                    during review; files selected during corrections are saved when you resubmit.
                </p>
            </div>

            <span class="badge text-bg-light border">
                @Model.Documents.Count() documents
            </span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Document</th>
                        <th scope="col">Required</th>
                        <th scope="col">Status</th>
                        <th scope="col">Remarks</th>
                        <th scope="col">File</th>
                        <th scope="col" style="min-width:280px">Select file / Replace</th>
                    </tr>
                </thead>

                <tbody>
                    @for (var i = 0; i < orderedDocuments.Count; i++)
                    {
                        var d = orderedDocuments[i];
                        var acceptedFileTypes = ".pdf,.jpg,.jpeg,.png";
                        var v = d.Versions
                            .OrderByDescending(x => x.VersionNumber)
                            .FirstOrDefault();
                        var rev = v?.Reviews
                            .OrderByDescending(r => r.ReviewedAt)
                            .FirstOrDefault();
                        var canUploadDuringReview =
                            (Model.Status is ApplicationStatus.PendingReview or ApplicationStatus.UnderReview) &&
                            (d.Status is DocumentStatus.NotSubmitted or DocumentStatus.Rejected);
                        var canUpload = canUploadDuringReview ||
                            (canEdit &&
                             (Model.Status == ApplicationStatus.Draft ||
                              (d.Status is DocumentStatus.NotSubmitted or DocumentStatus.Rejected)));

                        <tr>
                            <td class="fw-semibold">@d.DocumentType.DisplayName()</td>
                            <td>@(d.IsRequired ? "Yes" : "No")</td>
                            <td>
                                <span class="badge bg-@d.Status.Badge()">@d.Status</span>
                            </td>
                            <td class="text-danger">
                                @(d.Status == DocumentStatus.Rejected ? rev?.Remarks : null)
                            </td>
                            <td>
                                @if (v != null)
                                {
                                    <a asp-controller="Documents"
                                       asp-action="Get"
                                       asp-route-id="@v.DocumentVersionId"
                                       target="_blank"
                                       rel="noopener">View v@(v.VersionNumber)</a>
                                    <div class="small text-muted">
                                        Uploaded by @(v.UploadedBy?.Email ?? "Uploader not recorded")
                                        on @v.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Not uploaded</span>
                                }
                            </td>
                            <td>
                                @if (canEdit)
                                {
                                    <input type="hidden"
                                           name="Uploads[@i].DocumentType"
                                           value="@d.DocumentType"
                                           form="vendorApplicationForm" />
                                }

                                @if (canUpload && canEdit)
                                {
                                    <input type="file"
                                           name="Uploads[@i].File"
                                           class="form-control form-control-sm"
                                           accept="@acceptedFileTypes"
                                           aria-label="Select @d.DocumentType.DisplayName() file"
                                           form="vendorApplicationForm" />
                                }
                                else if (canUploadDuringReview)
                                {
                                    <form asp-controller="Vendor"
                                          asp-action="Upload"
                                          method="post"
                                          enctype="multipart/form-data"
                                          class="d-flex flex-column gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="@d.DocumentType" />
                                        <input type="file"
                                               name="file"
                                               class="form-control form-control-sm"
                                               accept="@acceptedFileTypes"
                                               aria-label="Select replacement for @d.DocumentType.DisplayName()"
                                               required />
                                        <button type="submit" class="btn btn-sm btn-outline-success align-self-start">
                                            Upload for review
                                        </button>
                                    </form>
                                }
                                else if (canEdit)
                                {
                                    <span class="text-muted small">
                                        Upload unavailable for this document status
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Uploads are closed for this status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- The main form submits required documents and the application. -->
    <form asp-controller="Vendor"
          asp-action="Submit"
          method="post"
          enctype="multipart/form-data"
          id="vendorApplicationForm">

        @Html.AntiForgeryToken()

    <!-- The single submit button -->
    @if (canEdit)
    {
        <section class="submit-panel" id="submit-application" aria-label="Submit application">
            <div>
                <h3>Ready to submit?</h3>
                <p>
                    Review your entries before submitting. Required documents must be provided
                    for the application to be processed.
                </p>
                <small>Accepted formats: PDF, JPG or PNG · Maximum 3 MB per file.</small>
            </div>

            <button type="submit" class="btn btn-success btn-lg" id="submitApplicationButton">
                @(Model.Status == ApplicationStatus.Draft
                    ? "Submit application"
                    : "Resubmit corrections")
                <span aria-hidden="true">→</span>
            </button>
        </section>
    }
</form>
