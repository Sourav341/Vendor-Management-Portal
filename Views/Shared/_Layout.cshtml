@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var isHomePage = activeController == "Home" && activeAction == "Index";
    var showSidebar = isAuthenticated && !isHomePage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#087b52" />
    <meta name="description" content="Vendor Management Portal for vendor registration, secure document submission and application tracking in Jharkhand." />
    <title>@ViewData["Title"] | Vendor Management Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body id="top" class="portal-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="tricolour-rule" aria-hidden="true"></div>
        <div class="site-header-inner">
            <div class="brand-copy">
                <h1 class="site-title">
                    Vendor Management Portal
                </h1>
            </div>
            <img class="site-emblem" src="~/images/jharkhand-state-emblem.png" alt="Jharkhand State Emblem" width="76" height="76" />
        </div>
    </header>

    <div class="portal-workspace @(showSidebar ? "has-sidebar" : "public-workspace")">
        @if (showSidebar)
        {
        <aside class="portal-sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <span class="sidebar-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 19V9l8-5 8 5v10"/><path d="M9 19v-6h6v6M2 19h20"/></svg>
                </span>
                <div>
                    <h2 class="sidebar-title">@(isAdmin ? "Admin Workspace" : isAuthenticated ? "Vendor Dashboard" : "Portal Navigation")</h2>
                </div>
            </div>

            <nav class="sidebar-navigation" aria-label="Portal sections">
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @(activeController == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9M9 20v-7h6v7"/></svg><span>Home</span>
                        </a>
                    </li>
                    @if (isAuthenticated)
                    {
                        if (isAdmin)
                        {
                            <li>
                                <a class="sidebar-link @(activeController == "Admin" ? "is-active" : "")" asp-controller="Admin" asp-action="Index">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M8 13h3M8 16h7M15 12h3"/></svg><span>Vendor Applications</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="sidebar-link @(activeController == "Vendor" ? "is-active" : "")" asp-controller="Vendor" asp-action="Dashboard">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="10" width="8" height="11" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/></svg><span>Overview</span>
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link" asp-controller="Vendor" asp-action="Dashboard" asp-fragment="application-status">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2M8.5 2.8 7 5M15.5 2.8 17 5"/></svg><span>Application Status</span>
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link" asp-controller="Vendor" asp-action="Dashboard" asp-fragment="required-documents">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/></svg><span>Required Documents</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </nav>

        </aside>
        }

        <div class="portal-main-column">
            @if (isAuthenticated)
            {
                <div class="portal-topbar">
                    <div class="portal-topbar-inner">
                        <span class="portal-user" title="Signed in as @User.Identity?.Name">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                            <span>@User.Identity?.Name</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="portal-logout-form">
                            <button type="submit" class="portal-logout-button">Logout</button>
                        </form>
                    </div>
                </div>
            }

            <main id="main-content" class="page-main portal-main-content">
                <div class="portal-content-container">
                    @if (TempData["Success"] is string ok)
                    {
                        <div class="alert alert-success portal-alert" role="status">@ok</div>
                    }
                    @if (TempData["Error"] is string err)
                    {
                        <div class="alert alert-danger portal-alert" role="alert">@err</div>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-main">
            <div class="container footer-grid">
                @* <section class="footer-column" aria-labelledby="footer-about-title">
                    <h2 id="footer-about-title" class="footer-title">About VB-G RAM G</h2>
                    <p>Viksit Bharat - Guarantee for Rozgar and Aajeevika Mission (Gramin) supports rural households through employment opportunities, transparent processes and sustainable village development.</p>
                </section> *@

                <section class="footer-column" aria-labelledby="footer-quick-title">
                    <h2 id="footer-quick-title" class="footer-title">Quick Links</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Vendor Login</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Vendor Registration</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Admin" asp-action="Index">Applications</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Vendor" asp-action="Dashboard">My Dashboard</a></li>
                            }
                        }
                    </ul>
                </section>

                <section class="footer-column footer-contact" aria-labelledby="footer-contact-title">
                    <h2 id="footer-contact-title" class="footer-title">Contact Us</h2>
                    <div class="contact-row">
                        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        <address>Department of Rural Development<br />Government of Jharkhand<br />Ranchi - 834001</address>
                    </div>
                    <div class="contact-row">
                        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="m3 6 9 7 9-7"/></svg>
                        <a href="mailto:nrega.jhr2015@gmail.com">nrega.jhr2015@gmail.com</a>
                    </div>
                </section>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container footer-bottom-inner">
                <span>© @DateTime.Now.Year Jharkhand. All rights reserved.</span>
                <span class="footer-updated">Last Updated: @DateTime.Now.ToString("dd MMMM yyyy")</span>
                <a href="#top" class="back-to-top" aria-label="Back to top" title="Back to top">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14 7-7 7 7M12 7v12" /></svg>
                </a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
