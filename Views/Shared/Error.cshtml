@{ ViewData["Title"] = "Error"; }
<section class="result-panel" aria-labelledby="error-title">
    <span class="result-icon" aria-hidden="true">!</span>
    <h1 id="error-title">We could not complete your request</h1>
    <p>An unexpected error occurred. Please return to the portal and try again. If the issue continues, contact the portal support team.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to home</a>
</section>
